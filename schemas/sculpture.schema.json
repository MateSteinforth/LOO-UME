{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://led-rhombo.example/schemas/sculpture.schema.json",
  "title": "Panelized LED sculpture source definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "units",
    "status",
    "panelProfile",
    "topology",
    "centerPanelMount",
    "mapping",
    "wiring",
    "calibration",
    "notes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "const": "mm"
    },
    "status": {
      "enum": [
        "provisional",
        "measured"
      ]
    },
    "panelProfile": {
      "type": "string",
      "minLength": 1
    },
    "topology": {
      "$ref": "#/$defs/rhombicosidodecahedronTopology"
    },
    "centerPanelMount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rotationDegrees",
        "offsetX",
        "offsetY",
        "recess",
        "polarEdgeRule"
      ],
      "properties": {
        "rotationDegrees": {
          "type": "number"
        },
        "offsetX": {
          "type": "number"
        },
        "offsetY": {
          "type": "number"
        },
        "recess": {
          "type": "number"
        },
        "polarEdgeRule": {
          "const": "top-edge-north-bottom-edge-south"
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection",
        "logicalOrder"
      ],
      "properties": {
        "projection": {
          "const": "equirectangular"
        },
        "logicalOrder": {
          "const": "north-to-south-then-longitude"
        }
      }
    },
    "wiring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "controller",
        "routeStrategy",
        "chainLengths",
        "connector",
        "outputs"
      ],
      "properties": {
        "status": {
          "enum": [
            "provisional",
            "measured"
          ]
        },
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "placement",
            "status"
          ],
          "properties": {
            "placement": {
              "const": "near-top"
            },
            "status": {
              "const": "provisional"
            }
          }
        },
        "routeStrategy": {
          "const": "longitude-sectors-nearest-neighbor"
        },
        "chainLengths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "connector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "edgeInset",
            "surfaceOffset"
          ],
          "properties": {
            "edgeInset": {
              "type": "number",
              "minimum": 0
            },
            "surfaceOffset": {
              "type": "number"
            }
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outputIndex",
              "label",
              "gpio",
              "color"
            ],
            "properties": {
              "outputIndex": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "gpio": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panelTransforms",
        "installedPanelOrientation",
        "panelPixelOrder",
        "physicalChains"
      ],
      "properties": {
        "panelTransforms": {
          "enum": [
            "generated-provisional",
            "measured"
          ]
        },
        "installedPanelOrientation": {
          "$ref": "#/$defs/factStatus"
        },
        "panelPixelOrder": {
          "enum": [
            "provisional",
            "measured"
          ]
        },
        "physicalChains": {
          "enum": [
            "provisional",
            "measured"
          ]
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "connectorCenterInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel",
        "hole",
        "edgeDistance"
      ],
      "properties": {
        "panel": {
          "const": "center"
        },
        "hole": {
          "const": "top-middle-edge"
        },
        "edgeDistance": {
          "const": 8
        }
      }
    },
    "connectorOuterInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel",
        "outerEdgeIndex",
        "hole",
        "edgeDistance"
      ],
      "properties": {
        "panel": {
          "const": "outer"
        },
        "outerEdgeIndex": {
          "const": 1
        },
        "hole": {
          "const": "middle-edge"
        },
        "edgeDistance": {
          "const": 8.2
        }
      }
    },
    "factStatus": {
      "enum": [
        "unknown",
        "provisional",
        "measured"
      ]
    },
    "rhombicosidodecahedronTopology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "family",
        "construction",
        "orientation",
        "faceEdge",
        "population"
      ],
      "properties": {
        "kind": {
          "const": "regular-polyhedron"
        },
        "family": {
          "const": "rhombicosidodecahedron"
        },
        "construction": {
          "const": "rectified-icosahedron-dual-frames"
        },
        "orientation": {
          "const": "vertex-up"
        },
        "faceEdge": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "population": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "squareFaces",
            "pentagonFaces",
            "triangleFaces"
          ],
          "properties": {
            "squareFaces": {
              "const": "all"
            },
            "pentagonFaces": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "excluded"
              ],
              "properties": {
                "mode": {
                  "const": "all-except"
                },
                "excluded": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "const": "north-pole"
                    }
                  ],
                  "items": false,
                  "minItems": 1,
                  "maxItems": 1
                }
              }
            },
            "triangleFaces": {
              "const": "fillers"
            }
          }
        }
      }
    }
  }
}
