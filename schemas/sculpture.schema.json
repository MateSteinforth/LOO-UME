{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://led-rhombo.example/schemas/sculpture.schema.json",
  "title": "Panelized LED sculpture source definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "units",
    "status",
    "panelProfile",
    "topology",
    "centerPanelMount",
    "openings",
    "mapping",
    "wiring",
    "calibration",
    "notes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "units": { "const": "mm" },
    "status": { "enum": ["provisional", "measured"] },
    "panelProfile": { "type": "string", "minLength": 1 },
    "topology": { "$ref": "#/$defs/rhombicosidodecahedronTopology" },
    "centerPanelMount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rotationDegrees",
        "offsetX",
        "offsetY",
        "recess",
        "polarEdgeRule"
      ],
      "properties": {
        "rotationDegrees": { "type": "number" },
        "offsetX": { "type": "number" },
        "offsetY": { "type": "number" },
        "recess": { "type": "number" },
        "polarEdgeRule": {
          "const": "top-edge-north-bottom-edge-south"
        }
      }
    },
    "openings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triangleFaces", "pentagonFaces"],
      "properties": {
        "triangleFaces": {
          "$ref": "#/$defs/triangleOpening"
        },
        "pentagonFaces": {
          "$ref": "#/$defs/pentagonOpening"
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "logicalOrder"],
      "properties": {
        "projection": { "const": "equirectangular" },
        "logicalOrder": {
          "const": "north-to-south-then-longitude"
        }
      }
    },
    "wiring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "routeStrategy",
        "chainLengths",
        "connector",
        "outputs"
      ],
      "properties": {
        "status": { "enum": ["provisional", "measured"] },
        "routeStrategy": {
          "const": "longitude-sectors-nearest-neighbor"
        },
        "chainLengths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "connector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "diagonal",
            "edgeInset",
            "surfaceOffset",
            "dinDoutAssignmentStatus"
          ],
          "properties": {
            "diagonal": { "const": "top-left-to-bottom-right" },
            "edgeInset": { "type": "number", "minimum": 0 },
            "surfaceOffset": { "type": "number" },
            "dinDoutAssignmentStatus": {
              "enum": ["provisional", "measured"]
            }
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["outputIndex", "label", "gpio", "color"],
            "properties": {
              "outputIndex": { "type": "integer", "minimum": 0 },
              "label": { "type": "string", "minLength": 1 },
              "gpio": { "type": ["integer", "null"] },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panelTransforms",
        "installedPanelOrientation",
        "panelPixelOrder",
        "physicalChains"
      ],
      "properties": {
        "panelTransforms": {
          "enum": ["generated-provisional", "measured"]
        },
        "installedPanelOrientation": { "$ref": "#/$defs/factStatus" },
        "panelPixelOrder": { "enum": ["provisional", "measured"] },
        "physicalChains": { "enum": ["provisional", "measured"] }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "triangleOpening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["faceType", "count", "population", "closure"],
      "properties": {
        "faceType": { "const": "triangle" },
        "count": { "const": 20 },
        "population": { "const": "all" },
        "closure": { "$ref": "#/$defs/triangleClosure" }
      }
    },
    "triangleClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partId",
        "canonicalSource",
        "generator",
        "generatedFile",
        "quantity",
        "modes",
        "handedness",
        "interfaces",
        "print"
      ],
      "properties": {
        "partId": { "const": "triangle-filler" },
        "canonicalSource": { "const": "parts/triangle.scad" },
        "generator": { "const": "verified-scad-wrapper" },
        "generatedFile": {
          "type": "string",
          "pattern": "^[^/]+[.]scad$"
        },
        "quantity": { "const": 20 },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["print", "assembly"],
          "properties": {
            "print": { "const": "print" },
            "assembly": { "const": "assembly" }
          }
        },
        "handedness": { "enum": [-1, 1] },
        "interfaces": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/trianglePanelInterface" },
                { "type": "object", "properties": { "edgeIndex": { "const": 0 } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/trianglePanelInterface" },
                { "type": "object", "properties": { "edgeIndex": { "const": 1 } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/trianglePanelInterface" },
                { "type": "object", "properties": { "edgeIndex": { "const": 2 } } }
              ]
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "print": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bedSurface"],
          "properties": {
            "bedSurface": { "const": "outside-cover" }
          }
        }
      }
    },
    "trianglePanelInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeIndex",
        "adjacentFaceType",
        "mountingHoleEnd",
        "connectorCornerClearance",
        "panelEnvelopeClearance"
      ],
      "properties": {
        "edgeIndex": { "type": "integer", "minimum": 0, "maximum": 2 },
        "adjacentFaceType": { "const": "square" },
        "mountingHoleEnd": {
          "const": "opposite-electrical-connector"
        },
        "connectorCornerClearance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "panelEnvelopeClearance": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "pentagonOpening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["faceType", "count", "population", "closure"],
      "properties": {
        "faceType": { "const": "pentagon" },
        "count": { "const": 12 },
        "population": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "excluded", "populatedCount"],
          "properties": {
            "mode": { "const": "all-except" },
            "excluded": {
              "type": "array",
              "prefixItems": [{ "const": "north-pole" }],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            },
            "populatedCount": { "const": 11 }
          }
        },
        "closure": { "$ref": "#/$defs/pentagonClosure" }
      }
    },
    "pentagonClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assemblyId",
        "quantity",
        "openOuterEdge",
        "parts",
        "assembly"
      ],
      "properties": {
        "assemblyId": { "const": "populated-pentagon-panel-mount" },
        "quantity": { "const": 11 },
        "openOuterEdge": { "const": 1 },
        "parts": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/pentagonUFrame" },
            { "$ref": "#/$defs/middlePanelConnector" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "assembly": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generatedFile", "preview"],
          "properties": {
            "generatedFile": {
              "type": "string",
              "pattern": "^[^/]+[.]scad$"
            },
            "preview": { "const": "center-and-five-outer-panels" }
          }
        }
      }
    },
    "pentagonUFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partId",
        "canonicalSource",
        "generator",
        "generatedFile",
        "quantity",
        "modes",
        "interfaces",
        "print"
      ],
      "properties": {
        "partId": { "const": "pentagon-u-frame" },
        "canonicalSource": { "const": "parts/pentagon_u.scad" },
        "generator": { "const": "verified-scad-wrapper" },
        "generatedFile": {
          "type": "string",
          "pattern": "^[^/]+[.]scad$"
        },
        "quantity": { "const": 11 },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["print", "assembly", "center"],
          "properties": {
            "print": { "const": "print" },
            "assembly": { "const": "assembly" },
            "center": { "const": "center" }
          }
        },
        "interfaces": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outerPanelEdges",
            "centerPanelHoles",
            "centerPanelClearance",
            "connectorCornerClearance"
          ],
          "properties": {
            "outerPanelEdges": {
              "type": "array",
              "prefixItems": [
                { "const": 0 },
                { "const": 2 },
                { "const": 3 },
                { "const": 4 }
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4
            },
            "centerPanelHoles": {
              "type": "array",
              "prefixItems": [
                { "const": "bottom-left-corner" },
                { "const": "bottom-middle-edge" },
                { "const": "top-right-corner" }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            "centerPanelClearance": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "connectorCornerClearance": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "print": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bedSurface"],
          "properties": {
            "bedSurface": { "const": "outside-cover" }
          }
        }
      }
    },
    "middlePanelConnector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partId",
        "canonicalSource",
        "generator",
        "generatedFile",
        "quantity",
        "modes",
        "interfaces",
        "print"
      ],
      "properties": {
        "partId": { "const": "middle-panel-connector" },
        "canonicalSource": {
          "const": "parts/middle_panel_connector.scad"
        },
        "generator": { "const": "verified-scad-wrapper" },
        "generatedFile": {
          "type": "string",
          "pattern": "^[^/]+[.]scad$"
        },
        "quantity": { "const": 11 },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["print", "assembly", "installed"],
          "properties": {
            "print": { "const": "print" },
            "assembly": { "const": "assembly" },
            "installed": { "const": "part" }
          }
        },
        "interfaces": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/connectorCenterInterface" },
            { "$ref": "#/$defs/connectorOuterInterface" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "print": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bedSurface"],
          "properties": {
            "bedSurface": { "const": "center-panel-pad" }
          }
        }
      }
    },
    "connectorCenterInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panel", "hole", "edgeDistance"],
      "properties": {
        "panel": { "const": "center" },
        "hole": { "const": "top-middle-edge" },
        "edgeDistance": { "const": 8 }
      }
    },
    "connectorOuterInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panel", "outerEdgeIndex", "hole", "edgeDistance"],
      "properties": {
        "panel": { "const": "outer" },
        "outerEdgeIndex": { "const": 1 },
        "hole": { "const": "middle-edge" },
        "edgeDistance": { "const": 8.2 }
      }
    },
    "factStatus": {
      "enum": ["unknown", "provisional", "measured"]
    },
    "rhombicosidodecahedronTopology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "family",
        "construction",
        "orientation",
        "faceEdge",
        "population"
      ],
      "properties": {
        "kind": { "const": "regular-polyhedron" },
        "family": { "const": "rhombicosidodecahedron" },
        "construction": {
          "const": "rectified-icosahedron-dual-frames"
        },
        "orientation": { "const": "vertex-up" },
        "faceEdge": { "type": "number", "exclusiveMinimum": 0 },
        "population": {
          "type": "object",
          "additionalProperties": false,
          "required": ["squareFaces", "pentagonFaces", "triangleFaces"],
          "properties": {
            "squareFaces": { "const": "all" },
            "pentagonFaces": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "excluded"],
              "properties": {
                "mode": { "const": "all-except" },
                "excluded": {
                  "type": "array",
                  "prefixItems": [{ "const": "north-pole" }],
                  "items": false,
                  "minItems": 1,
                  "maxItems": 1
                }
              }
            },
            "triangleFaces": { "const": "fillers" }
          }
        }
      }
    }
  }
}
