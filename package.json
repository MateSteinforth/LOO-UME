{
  "name": "led-rhombo-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup:wled": "sh scripts/setup-wled.sh",
    "setup:emsdk": "sh scripts/setup-emsdk.sh",
    "check:wled": "node scripts/check-wled-sync.mjs",
    "validate:sculpture": "tsx scripts/validate-sculpture.ts",
    "stage:sculptures": "node scripts/stage-sculpture-json.mjs",
    "generate:mapping": "tsx scripts/generate-mapping.ts",
    "optimize:wiring-orientation": "tsx scripts/optimize-installed-orientations.ts",
    "generate:mapping:hardware": "tsx scripts/generate-mapping.ts --hardware",
    "generate:panel-boundary": "tsx scripts/generate-panel-boundary-parts.ts",
    "generate:assets": "npm run stage:sculptures && npm run generate:mapping",
    "verify:desktop-install": "tsx scripts/verify-local-editor-install.ts",
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run generate:assets && npm run build:wasm && vite",
    "dev:web": "npm run stage:sculptures && npm run build:wasm && vite",
    "preview:phone": "sh scripts/start-phone-preview.sh",
    "build": "npm run generate:assets && npm run build:wasm && tsc -b && vite build",
    "build:web": "vite build",
    "build:desktop": "npm run stage:sculptures && npx tsc -b && npm run build:web",
    "start:desktop": "tsx scripts/local-editor-server.ts",
    "desktop": "npm run build:desktop && npm run start:desktop",
    "preview": "vite preview",
    "serve:test:browser": "npm run stage:sculptures && vite --host 127.0.0.1 --port 4174 --strictPort",
    "setup:browser": "PLAYWRIGHT_BROWSERS_PATH=.tools/playwright playwright install chromium",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=.tools/playwright playwright test",
    "test:panel-editing": "vitest run --config vitest.config.ts tests/panel-json-editing.test.ts tests/selection-focus.test.ts",
    "test:placement": "vitest run --config vitest.config.ts tests/automatic-panel-placement.test.ts",
    "test:editor": "vitest run --config vitest.config.ts tests/sculpture-editor.test.ts tests/panel-json-editing.test.ts tests/automatic-panel-placement.test.ts tests/selection-focus.test.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:full": "npm run build:wasm && npm test",
    "test": "npm run test:unit",
    "verify": "npm run generate:assets && npm run build:wasm && npm test && npx tsc -b && npm run build:web",
    "verify:clean": "sh scripts/verify-clean.sh"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "manifold-3d": "3.5.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.30",
    "@types/three": "^0.179.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
