{
  "name": "led-rhombo-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup:emsdk": "sh scripts/setup-emsdk.sh",
    "check:wled": "node scripts/check-wled-sync.mjs",
    "generate:mapping": "tsx scripts/generate-mapping.ts",
    "generate:mapping:hardware": "tsx scripts/generate-mapping.ts --hardware",
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run generate:mapping && npm run build:wasm && vite",
    "dev:web": "vite",
    "build": "npm run generate:mapping && npm run build:wasm && tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run generate:mapping && npm run build:wasm && vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/three": "^0.179.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
