#!/bin/sh
set -eu

application_name="LOO UME.app"
support_root=${LOO_UME_SUPPORT_ROOT:-$HOME/Library/Application Support/LOO-UME}
checkout_root=$support_root/application
applications_root=${LOO_UME_APPLICATIONS_ROOT:-/Applications}
installed_app=$applications_root/$application_name
legacy_app=$HOME/Applications/$application_name
repository_url=https://github.com/MateSteinforth/LOO-UME.git
source_app=$(CDPATH= cd -- "${0%/*}/../.." && pwd -P)
log_directory=$support_root/logs
install_log=$log_directory/install.log
ditto_command=${LOO_UME_DITTO_COMMAND:-/usr/bin/ditto}
git_command=${LOO_UME_GIT_COMMAND:-/usr/bin/git}
open_command=${LOO_UME_APP_OPEN_COMMAND:-/usr/bin/open}
osascript_command=${LOO_UME_OSASCRIPT_COMMAND:-/usr/bin/osascript}
xcode_select_command=${LOO_UME_XCODE_SELECT_COMMAND:-/usr/bin/xcode-select}
documents_root=${LOO_UME_DOCUMENTS_ROOT:-$HOME/Documents}
curl_command=${LOO_UME_CURL_COMMAND:-/usr/bin/curl}
lsof_command=${LOO_UME_LSOF_COMMAND:-/usr/sbin/lsof}
cmp_command=${LOO_UME_CMP_COMMAND:-/usr/bin/cmp}
managed_port_file=$checkout_root/.tools/looume/server.port
if [ -n "${LOO_UME_PORT:-}" ]; then
  port=$LOO_UME_PORT
elif [ -f "$managed_port_file" ]; then
  IFS= read -r port < "$managed_port_file" || port=4173
else
  port=4173
fi

progress() {
  printf '\nLOO/UME — %s\n' "$1"
}

show_error() {
  message=$1
  if [ -x "$osascript_command" ]; then
    "$osascript_command" -e 'on run argv' \
      -e 'display alert "LOO/UME could not start" message (item 1 of argv) as critical' \
      -e 'end run' -- "$message" >/dev/null 2>&1 || true
  fi
  echo "LOO/UME: $message" >&2
}

notify() {
  message=$1
  if [ -x "$osascript_command" ]; then
    "$osascript_command" -e 'on run argv' \
      -e 'display notification (item 1 of argv) with title "LOO/UME"' \
      -e 'end run' -- "$message" >/dev/null 2>&1 || true
  fi
}

open_progress_terminal() {
  [ "${LOO_UME_TERMINAL_SESSION:-0}" != 1 ] || return 1
  [ "${LOO_UME_SKIP_TERMINAL_HANDOFF:-0}" != 1 ] || return 1
  [ -x "$osascript_command" ] || return 1
  terminal_launcher=$0
  if [ -x "$installed_app/Contents/MacOS/LOO-UME" ]; then
    terminal_launcher=$installed_app/Contents/MacOS/LOO-UME
  fi
  "$osascript_command" \
    -e 'on run argv' \
    -e 'set launcherPath to item 1 of argv' \
    -e 'tell application "Terminal"' \
    -e 'activate' \
    -e 'do script "env LOO_UME_TERMINAL_SESSION=1 /bin/sh " & quoted form of launcherPath' \
    -e 'end tell' \
    -e 'end run' -- "$terminal_launcher" >/dev/null 2>&1
}

run_privileged_application_replace() {
  replacement_script=$1
  staging_app=$2
  backup_app=$3
  if [ -w "$applications_root" ]; then
    /bin/sh "$replacement_script" "$staging_app" "$installed_app" "$backup_app"
    return
  fi
  [ -x "$osascript_command" ] || return 1
  "$osascript_command" \
    -e 'on run argv' \
    -e 'do shell script "/bin/sh " & quoted form of (item 1 of argv) & " " & quoted form of (item 2 of argv) & " " & quoted form of (item 3 of argv) & " " & quoted form of (item 4 of argv) with administrator privileges' \
    -e 'end run' -- "$replacement_script" "$staging_app" "$installed_app" "$backup_app"
}

remove_installed_application() {
  [ -e "$installed_app" ] || return 0
  if [ -w "$applications_root" ]; then
    rm -rf "$installed_app"
    return
  fi
  [ -x "$osascript_command" ] || return 1
  "$osascript_command" \
    -e 'on run argv' \
    -e 'do shell script "/bin/rm -rf -- " & quoted form of (item 1 of argv) with administrator privileges' \
    -e 'end run' -- "$installed_app"
}

recover_orphaned_server_record() {
  state_directory=$checkout_root/.tools/looume
  server_pid_file=$state_directory/server.pid
  [ ! -f "$server_pid_file" ] || return 0
  [ -x "$curl_command" ] || return 0
  [ -x "$lsof_command" ] || return 0
  readiness=$(
    "$curl_command" --fail --silent --show-error --max-time 2 \
      "http://127.0.0.1:$port/api/generator-status" 2>/dev/null
  ) || return 0
  printf '%s' "$readiness" | /usr/bin/grep -Fq '"schemaVersion":"1.0.0"' || return 0
  printf '%s' "$readiness" | /usr/bin/grep -Fq '"generator":"manifold"' || return 0
  candidate_pids=$(
    "$lsof_command" -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null || true
  )
  candidate_pid=
  for discovered_pid in $candidate_pids; do
    case $discovered_pid in ''|*[!0-9]*) continue ;; esac
    if [ -n "$candidate_pid" ] && [ "$candidate_pid" != "$discovered_pid" ]; then
      progress "Port $port has more than one listening process. Ownership was not changed."
      return 0
    fi
    candidate_pid=$discovered_pid
  done
  [ -n "$candidate_pid" ] || return 0
  candidate_command=$(/bin/ps -p "$candidate_pid" -o command= 2>/dev/null || true)
  case $candidate_command in
    *"$checkout_root/bootstrap.sh launch"*|*"$checkout_root/bootstrap.sh update"*|*"$checkout_root/scripts/local-editor-server.ts"*) ;;
    *)
      progress "Port $port belongs to a LOO/UME-compatible process outside this managed installation. Ownership was not changed."
      return 0
      ;;
  esac
  mkdir -p "$state_directory"
  chmod 700 "$state_directory"
  printf '%s\n' "$candidate_pid" > "$server_pid_file"
  progress "Recovered the existing managed LOO/UME server on port $port."
}

confirm_uninstall() {
  [ "${LOO_UME_CONFIRM_UNINSTALL:-0}" != 1 ] || return 0
  if [ -x "$osascript_command" ]; then
    answer=$(
      "$osascript_command" \
        -e 'button returned of (display alert "Remove LOO/UME?" message "The application and managed installation will be removed. Local Project Library files will first be copied to Documents." buttons {"Cancel", "Uninstall"} default button "Cancel" cancel button "Cancel")' \
        2>/dev/null || true
    )
    [ "$answer" = Uninstall ] && return 0
    return 1
  fi
  printf 'Type UNINSTALL to remove the managed LOO/UME installation: '
  IFS= read -r answer
  [ "$answer" = UNINSTALL ]
}

uninstall_application() {
  if ! confirm_uninstall; then
    progress "Uninstall cancelled."
    return 0
  fi
  case $support_root in ''|/|"$HOME") show_error "The managed support path is unsafe."; exit 1 ;; esac
  case $installed_app in ''|/|"$HOME") show_error "The application path is unsafe."; exit 1 ;; esac
  recover_orphaned_server_record
  progress "Stopping the managed server."
  if [ -x "$checkout_root/scripts/looume.sh" ]; then
    /bin/sh "$checkout_root/scripts/looume.sh" --stop || {
      show_error "The managed server did not stop. Uninstall stopped without deleting files."
      exit 1
    }
  fi
  local_projects=$checkout_root/projects/local
  if [ -d "$local_projects" ]; then
    backup_root="$documents_root/LOO-UME Projects Backup-$(date +%Y%m%d-%H%M%S)-$$"
    mkdir -p "$documents_root"
    progress "Backing up local projects to $backup_root"
    "$ditto_command" "$local_projects" "$backup_root"
  fi
  progress "Removing the managed application and checkout."
  if ! remove_installed_application; then
    show_error "macOS did not authorize removal of $installed_app. The managed checkout was kept."
    exit 1
  fi
  command_link=$HOME/.local/bin/looume
  managed_command=$support_root/bin/looume
  if [ -L "$command_link" ] && [ "$(readlink "$command_link")" = "$managed_command" ]; then
    rm -f "$command_link"
  fi
  if [ "$legacy_app" != "$installed_app" ]; then rm -rf "$legacy_app"; fi
  rm -rf "$support_root"
  progress "Uninstall complete. Any project backup is in $documents_root."
  return 0
}

case ${1-} in
  '') ;;
  --uninstall) uninstall_application; exit 0 ;;
  *) show_error "Unsupported launcher argument: $1"; exit 2 ;;
esac

lock_claim_owner_is_live() {
  claim_path=$1
  [ -L "$claim_path" ] || return 1
  lock_pid=$(readlink "$claim_path") || return 1
  case $lock_pid in
    ''|*[!0-9]*) return 1 ;;
  esac
  kill -0 "$lock_pid" 2>/dev/null || return 1
  lock_command=$(/bin/ps -p "$lock_pid" -o command= 2>/dev/null || true)
  case $lock_command in
    *"/Contents/MacOS/LOO-UME"*|*"macos/launcher/Contents/MacOS/LOO-UME"*) return 0 ;;
    *) return 1 ;;
  esac
}

legacy_lock_owner_is_live() {
  legacy_lock_path=$1
  [ -f "$legacy_lock_path/owner.pid" ] || return 1
  IFS= read -r lock_pid < "$legacy_lock_path/owner.pid" || return 1
  case $lock_pid in
    ''|*[!0-9]*) return 1 ;;
  esac
  kill -0 "$lock_pid" 2>/dev/null || return 1
  lock_command=$(/bin/ps -p "$lock_pid" -o command= 2>/dev/null || true)
  case $lock_command in
    *"/Contents/MacOS/LOO-UME"*|*"macos/launcher/Contents/MacOS/LOO-UME"*) return 0 ;;
    *) return 1 ;;
  esac
}

remove_stale_lock_claims() {
  claims_base=$1
  if [ -d "$claims_base" ] && ! legacy_lock_owner_is_live "$claims_base"; then
    rm -f "$claims_base/owner.pid"
    rmdir "$claims_base" 2>/dev/null || true
  fi
  for claim_candidate in "$claims_base".claim.*; do
    [ -L "$claim_candidate" ] || continue
    if ! lock_claim_owner_is_live "$claim_candidate"; then
      rm -f "$claim_candidate"
    fi
  done
}

acquire_lock() {
  lock_path=$1
  remove_stale_lock_claims "$lock_path"
  [ -d "$lock_path" ] && return 1
  lock_timestamp=$(date +%s)
  acquired_lock_claim=$lock_path.claim.$lock_timestamp.$$
  ln -s "$$" "$acquired_lock_claim" 2>/dev/null || return 1
  sleep 1
  remove_stale_lock_claims "$lock_path"
  if [ -d "$lock_path" ]; then
    rm -f "$acquired_lock_claim"
    acquired_lock_claim=
    return 1
  fi
  first_lock_claim=
  for claim_candidate in "$lock_path".claim.*; do
    [ -L "$claim_candidate" ] || continue
    first_lock_claim=$claim_candidate
    break
  done
  if [ "$first_lock_claim" = "$acquired_lock_claim" ]; then return 0; fi
  rm -f "$acquired_lock_claim"
  acquired_lock_claim=
  return 1
}

release_lock() {
  lock_claim=$1
  if [ -n "$lock_claim" ] && [ -L "$lock_claim" ] &&
     [ "$(readlink "$lock_claim")" = "$$" ]; then
    rm -f "$lock_claim"
  fi
}

application_bundle_matches_installed() {
  [ -x "$cmp_command" ] || return 1
  [ -f "$source_app/Contents/MacOS/LOO-UME" ] || return 1
  [ -f "$installed_app/Contents/MacOS/LOO-UME" ] || return 1
  [ -f "$source_app/Contents/Info.plist" ] || return 1
  [ -f "$installed_app/Contents/Info.plist" ] || return 1
  "$cmp_command" -s \
    "$source_app/Contents/MacOS/LOO-UME" \
    "$installed_app/Contents/MacOS/LOO-UME" &&
    "$cmp_command" -s \
      "$source_app/Contents/Info.plist" \
      "$installed_app/Contents/Info.plist"
}

install_application_bundle() {
  if [ "${LOO_UME_SKIP_APP_COPY:-0}" = 1 ] ||
     [ "$source_app" = "$installed_app" ] ||
     application_bundle_matches_installed; then
    return 0
  fi
  progress "Copying LOO UME.app to $applications_root"
  if [ ! -d "$applications_root" ]; then
    mkdir -p "$applications_root" 2>/dev/null || {
      show_error "The application folder does not exist: $applications_root"
      exit 1
    }
  fi
  mkdir -p "$support_root"
  if [ -w "$applications_root" ]; then
    copy_lock=$applications_root/.LOO-UME.copy.lock
  else
    copy_lock=$support_root/app-copy.lock
  fi
  staging_app=$support_root/.LOO-UME.app.stage
  obsolete_staging_app=$applications_root/.LOO-UME.app.stage
  backup_app=$applications_root/.LOO-UME.app.backup
  replacement_script=$support_root/.replace-application.$$.sh
  if ! acquire_lock "$copy_lock"; then
    show_error "Another LOO/UME application copy is already running."
    exit 1
  fi
  copy_lock_claim=$acquired_lock_claim
  rm -rf "$staging_app"
  if [ -w "$applications_root" ]; then rm -rf "$obsolete_staging_app"; fi
  copy_committed=false
  cleanup_copy() {
    rm -rf "$staging_app"
    rm -f "$replacement_script"
    release_lock "$copy_lock_claim"
  }
  trap cleanup_copy EXIT
  trap 'exit 130' HUP INT TERM
  "$ditto_command" "$source_app" "$staging_app"
  printf '%s\n' \
    '#!/bin/sh' \
    'set -eu' \
    'staging_app=$1' \
    'installed_app=$2' \
    'backup_app=$3' \
    'if [ ! -d "$staging_app/Contents" ]; then exit 1; fi' \
    'if [ ! -e "$installed_app" ] && [ -e "$backup_app" ]; then mv "$backup_app" "$installed_app"; fi' \
    'if [ -e "$installed_app" ] && [ -e "$backup_app" ]; then rm -rf "$backup_app"; fi' \
    'if [ -e "$installed_app" ]; then mv "$installed_app" "$backup_app"; fi' \
    'if mv "$staging_app" "$installed_app"; then rm -rf "$backup_app"; exit 0; fi' \
    'if [ ! -e "$installed_app" ] && [ -e "$backup_app" ]; then mv "$backup_app" "$installed_app"; fi' \
    'exit 1' > "$replacement_script"
  chmod 700 "$replacement_script"
  if ! run_privileged_application_replace \
    "$replacement_script" "$staging_app" "$backup_app"; then
    show_error "macOS did not authorize installation in $applications_root. The previous app was preserved."
    exit 1
  fi
  copy_committed=true
  rm -f "$replacement_script"
  if [ "$legacy_app" != "$installed_app" ] && [ -e "$legacy_app" ]; then
    rm -rf "$legacy_app"
  fi
  release_lock "$copy_lock_claim"
  trap - EXIT HUP INT TERM
  if [ "${LOO_UME_TERMINAL_SESSION:-0}" = 1 ]; then
    LOO_UME_SKIP_APP_COPY=1 LOO_UME_TERMINAL_SESSION=1 \
      LOO_UME_RESUMED_AFTER_COPY=1 \
      exec /bin/sh "$installed_app/Contents/MacOS/LOO-UME"
  fi
  LOO_UME_SKIP_APP_COPY=1 "$open_command" "$installed_app"
  exit 0
}

install_checkout() {
  lock_directory=$support_root/install.lock
  remove_stale_lock_claims "$lock_directory"
  if [ -d "$checkout_root/.git" ]; then return 0; fi
  progress "Downloading the current verified application from GitHub."
  mkdir -p "$support_root" "$log_directory"
  if ! acquire_lock "$lock_directory"; then
    show_error "Another installation is already running. Wait, then open LOO/UME again."
    exit 1
  fi
  install_lock_claim=$acquired_lock_claim
  staging_root=$support_root/.application.stage
  rm -rf "$staging_root"
  cleanup_install() {
    rm -rf "$staging_root"
    release_lock "$install_lock_claim"
  }
  trap cleanup_install EXIT
  trap 'exit 130' HUP INT TERM
  if [ -e "$checkout_root" ]; then
    show_error "The application folder exists but is incomplete: $checkout_root"
    exit 1
  fi
  if [ ! -x "$git_command" ] || ! "$git_command" --version >/dev/null 2>&1; then
    if [ -x "$xcode_select_command" ]; then "$xcode_select_command" --install >/dev/null 2>&1 || true; fi
    show_error "macOS must finish installing its Command Line Tools. Then open LOO/UME again."
    exit 1
  fi
  notify "Installing the verified application. The first launch can take several minutes."
  : > "$install_log"
  clone_checkout() {
    "$git_command" clone --progress --branch main --single-branch \
      "$repository_url" "$staging_root"
  }
  if [ "${LOO_UME_TERMINAL_SESSION:-0}" = 1 ]; then
    clone_checkout_failed=false
    clone_checkout || clone_checkout_failed=true
  else
    clone_checkout_failed=false
    clone_checkout >> "$install_log" 2>&1 || clone_checkout_failed=true
  fi
  if [ "$clone_checkout_failed" = true ]; then
    show_error "The application download failed. See $install_log"
    exit 1
  fi
  if [ "$("$git_command" -C "$staging_root" remote get-url origin)" != "$repository_url" ] ||
     [ "$("$git_command" -C "$staging_root" branch --show-current)" != main ]; then
    show_error "The downloaded checkout did not match the approved main branch."
    exit 1
  fi
  mv "$staging_root" "$checkout_root"
  trap - EXIT HUP INT TERM
  release_lock "$install_lock_claim"
}

install_command_link() {
  command_root=$support_root/bin
  user_bin=$HOME/.local/bin
  mkdir -p "$command_root" "$user_bin"
  command_path=$command_root/looume
  temporary_command=$command_root/.looume.$$
  printf '%s\n' '#!/bin/sh' \
    "exec /bin/sh '$checkout_root/scripts/looume.sh' \"\$@\"" > "$temporary_command"
  chmod 755 "$temporary_command"
  mv "$temporary_command" "$command_path"
  ln -sfn "$command_path" "$user_bin/looume"
}

select_managed_port() {
  server_pid_file=$checkout_root/.tools/looume/server.pid
  [ ! -f "$server_pid_file" ] || return 0
  original_port=$port
  last_port=$((original_port + 26))
  while [ "$port" -le "$last_port" ]; do
    port_busy=false
    if [ -x "$lsof_command" ] &&
       [ -n "$("$lsof_command" -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null || true)" ]; then
      port_busy=true
    elif [ -x "$curl_command" ] &&
         "$curl_command" --silent --max-time 1 "http://127.0.0.1:$port/" >/dev/null 2>&1; then
      port_busy=true
    fi
    [ "$port_busy" = true ] || break
    port=$((port + 1))
  done
  if [ "$port" -gt "$last_port" ]; then
    show_error "No free local application port was found from $original_port through $last_port."
    exit 1
  fi
  mkdir -p "${managed_port_file%/*}"
  chmod 700 "${managed_port_file%/*}"
  printf '%s\n' "$port" > "$managed_port_file"
  if [ "$port" != "$original_port" ]; then
    progress "Port $original_port belongs to another application. This installation will use port $port."
  fi
  LOO_UME_PORT=$port
  export LOO_UME_PORT
}

install_application_bundle
if open_progress_terminal; then exit 0; fi
if [ "${LOO_UME_RESUMED_AFTER_COPY:-0}" != 1 ]; then
  progress "Starting the installer. This window shows its progress."
fi
install_checkout
recover_orphaned_server_record
select_managed_port
progress "Preparing the local command and application service."
install_command_link
progress "Starting LOO/UME. Detailed setup output follows."
if [ "${LOO_UME_TERMINAL_SESSION:-0}" = 1 ]; then
  if LOO_UME_FOLLOW_LOG=1 /bin/sh "$checkout_root/scripts/looume.sh" launch; then
    progress "Ready. The browser is open. The app is installed at $installed_app. This window closes in 8 seconds."
    sleep 8
    exit 0
  fi
  progress "Startup failed. Review $log_directory and press Return to close."
  IFS= read -r _unused
  exit 1
fi
exec /bin/sh "$checkout_root/scripts/looume.sh" launch
