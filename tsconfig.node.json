{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "scripts",
    "src",
    "tests",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "web/src/LedMapping.ts",
    "web/src/WiringPreview.ts",
    "web/src/WiringRouteEditor.ts",
    "web/src/HardwareMapping.ts",
    "web/src/WiringAssemblyManual.ts",
    "web/src/EditorCapabilities.ts",
    "web/src/DesignSurfaceLoader.ts",
    "web/src/EditorPipelineRequest.ts",
    "web/src/GeneratedMechanicsAssets.ts",
    "web/src/GeneratorStatus.ts",
    "web/src/PortableProject.ts",
    "web/src/SelectionFocus.ts",
    "web/src/SurfacePlacementController.ts"
  ]
}
